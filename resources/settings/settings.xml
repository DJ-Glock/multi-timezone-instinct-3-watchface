        </setting>

        <setting propertyKey="@Properties.secondLocationLatitude" title="Location latitude">
            <settingConfig type="numeric" />
        </setting>

        <setting propertyKey="@Properties.secondLocationLongtitude" title="Location longtitude">
            <settingConfig type="numeric" />
        </setting>
    </group>

    <group id="thirdLocation" title="Third location" description="Please leave name empty if you don't want to show it. For west and south please enter a negative number. If you need UTC time, please set UTC as name.">
        <setting propertyKey="@Properties.thirdLocationName" title="Location name">
            <settingConfig type="alphaNumeric" />
        </setting>

        <setting propertyKey="@Properties.thirdLocationLatitude" title="Location latitude">
            <settingConfig type="numeric" />
        </setting>

        <setting propertyKey="@Properties.thirdLocationLongtitude" title="Location longtitude">
            <settingConfig type="numeric" />
        </setting>
    </group>

</settings>
