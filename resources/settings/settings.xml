<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <group id="firstLocation" title="First location" description="Please leave name empty if you don't want to show it. For west and south please enter a negative number. If you need UTC time, please set UTC as name.">
        <setting propertyKey="@Properties.firstLocationName" title="First location name">
            <settingConfig type="alphaNumeric" />
        </setting>

        <setting propertyKey="@Properties.firstLocationLatitude" title="Location latitude">
            <settingConfig type="numeric" />
        </setting>

        <setting propertyKey="@Properties.firstLocationLongtitude" title="Location longtitude">
            <settingConfig type="numeric" />
        </setting>
    </group>

    <group id="secondLocation" title="Second location" description="Please leave name empty if you don't want to show it. For west and south please enter a negative number. If you need UTC time, please set UTC as name.">
